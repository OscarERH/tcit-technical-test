# Copy to .env. Everything here is optional: the app runs without it.

# Host ports.
WEB_PORT=4200
API_PORT=8080

# Gemini: enables "Completar con IA".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Google Drive: enables attachments. Needs a service-account key at
# ./secrets/drive-service-account.json and a folder inside a shared drive
# where that service account is a member.
DRIVE_CREDENTIALS_FILE=
# DRIVE_CREDENTIALS_FILE=/secrets/drive-service-account.json
DRIVE_FOLDER_ID=
